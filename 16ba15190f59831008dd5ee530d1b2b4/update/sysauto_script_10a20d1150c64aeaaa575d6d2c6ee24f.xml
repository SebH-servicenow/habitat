        <script><![CDATA[
(function() {
    var now = new GlideDateTime();
    var gr = new GlideRecord('x_snc_habitat_dossier_metier');
    gr.addQuery('state', 'IN', '1,2,3');
    gr.addQuery('due_date', '<', now);
    gr.addQuery('priority', '!=', '1');
    gr.query();
    
    var count = 0;
    while (gr.next()) {
        gr.setValue('priority', '1');
        gr.update();
        count++;
    }
    
    gs.info('Habitat SLA Breach: ' + count + ' dossier(s) escaladé(s) en priorité critique');
})();
]]></script>
