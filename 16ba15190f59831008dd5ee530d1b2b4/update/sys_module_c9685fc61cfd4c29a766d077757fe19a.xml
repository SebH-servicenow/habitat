        <content><![CDATA[import { gs } from '@servicenow/glide'

// BR: Prise en charge automatique
// Quand state passe à "En cours" (2) et assigned_to est vide,
// assigne l'agent courant
(function() {
    current.assigned_to = gs.getUserID();
    gs.info('Habitat: Dossier ' + current.number + ' pris en charge par ' + gs.getUserName());
})()
]]></content>
